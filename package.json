{
  "name": "nativescript-confettiview-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "husky && npx ts-patch install",
    "setup": "npx rimraf node_modules package-lock.json dist tmp && npm install",
    "start": "nps",
    "add": "nx g @nativescript/plugin-tools:add-package",
    "config": "nx g @nativescript/plugin-tools:config",
    "publish-packages": "nx g @nativescript/plugin-tools:publish",
    "sync-packages-with-demos": "nx g @nativescript/plugin-tools:sync-packages-with-demos",
    "remove-package": "nx g @nativescript/plugin-tools:remove-package",
    "add-demo": "nx g @nativescript/plugin-tools:add-demo",
    "build": "nx run-many --target=build.all --all",
    "demo.ios": "nx debug demo ios",
    "demo.android": "nx debug demo android",
    "clean": "nx clean demo",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@nativescript/core": "~9.1.0",
    "@nativescript/plugin-tools": "5.5.3",
    "@nativescript/types": "~9.1.0",
    "@nativescript/webpack": "~5.0.38",
    "husky": "~9.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "sass": "1.53.0",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "sass": "1.53.0"
  },
  "lint-staged": {
    "**/*.{js,ts,scss,json,html,md}": [
      "oxfmt"
    ],
    "**/*.{js,ts}": [
      "oxlint"
    ]
  }
}
